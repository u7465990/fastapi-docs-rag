# Application
APP_NAME=fastapi-docs-rag
ENVIRONMENT=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# LLM
LLM_PROVIDER=openai_compatible
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Embedding
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIM=1024

# Reranker
RERANKER_PROVIDER=local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=fastapi_docs_current
QDRANT_BUILD_PREFIX=fastapi_docs_build

# Documentation source / incremental index
DOCS_REPO_URL=https://github.com/fastapi/fastapi.git
DOCS_REPO_BRANCH=master
DOCS_CHECKOUT_DIR=data/raw/fastapi
INDEX_REFRESH_CRON=0 3 * * *
STALENESS_THRESHOLD_HOURS=24
DEFAULT_DOCS_VERSION=latest
INCLUDE_DEPRECATED=true
EMBEDDING_CACHE_DIR=data/cache/embeddings

# Redis
REDIS_URL=redis://localhost:6379/0

# Retrieval
RETRIEVAL_DENSE_TOP_K=40
RETRIEVAL_SPARSE_TOP_K=40
RERANK_TOP_K=20
FINAL_TOP_K=8
MAX_CONTEXT_TOKENS=8000

# Observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=fastapi-rag-dev

# API
ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=30
